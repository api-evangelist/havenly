{
  "opencollection": "1.0.0",
  "info": {
    "name": "Havenly Addresses Board Feedback API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Board Feedback",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Board Feedback (collection)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.havenly.com/board-feedback",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get all board feedback for the authed user."
        },
        {
          "info": {
            "name": "Create Board Feedback",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.havenly.com/board-feedback",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a piece of board feedback"
        },
        {
          "info": {
            "name": "Board Feedback By ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.havenly.com/board-feedback/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get a single entity of board feedback by ID."
        },
        {
          "info": {
            "name": "Remove a piece of board feedback",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.havenly.com/board-feedback/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "This deletes board feedback by ID."
        }
      ]
    }
  ],
  "bundled": true
}