{
  "opencollection": "1.0.0",
  "info": {
    "name": "Havenly Addresses Board Feedback Questions API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Board Feedback Questions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Board Feedback Questions (collection)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.havenly.com/board-feedback-questions",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get all board feedback questions"
        },
        {
          "info": {
            "name": "Board Feedback Question by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.havenly.com/board-feedback-questions/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get a specific board feedback question by ID"
        }
      ]
    }
  ],
  "bundled": true
}